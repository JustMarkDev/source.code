{
  "name": "source-code",
  "private": true,
  "license": "BUSL-1.1",
  "sideEffects": false,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "convex dev --start 'bun run --cwd apps/web dev'",
    "check": "vp check && bun run typecheck",
    "typecheck": "bun check --no-script",
    "build": "bun run typecheck && bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "format": "vp fmt .",
    "lint": "vp lint",
    "test": "bun test",
    "test:convex": "SX_DOMAIN=convex bun test --timeout 60000 packages/api",
    "prepare": "vp config"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.13.0",
    "@noble/hashes": "^2.4.0",
    "@source-code/api": "workspace:*",
    "better-auth": "~1.7.16",
    "convex": "^1.49.0",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@source-code/sdk": "workspace:*",
    "@convex-dev/eslint-plugin": "^5.0.1",
    "@types/bun": "^1.4.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "convex-test": "^0.0.67",
    "oxfmt": "0.76.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "minimatch": "^11.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "patchedDependencies": {
    "convex-test@0.0.67": "patches/convex-test@0.0.67.patch"
  }
}
